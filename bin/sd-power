#!/usr/bin/env bash
# sd-power — cuts / restores power on the Dell WD19TB dock ports that carry the
# Stream Deck Plus and everything plugged into it.
#
# WHY THIS DETOUR rather than a physical switch on the cable:
# the WD19TB's internal hubs advertise "ppps" (per-port power switching — the
# ability to cut the +5 V of one precise port with a standard USB command).
# uhubctl sends that command. Verified on 2026-08-19 on this dock: the write
# goes through WITHOUT sudo, and the status bit really flips (0100 power -> 0000 off).
#
# MAIN PITFALL, hence the notion of a "pair" below: one physical socket on the
# dock is wired to TWO internal hubs at once — a USB 2.0 one and a USB 3.x one.
# Cutting only one of the two leaves the +5 V present through the other path and
# the device stays powered. The config lists a PAIR of "hub port" targets, not one.
#
# Config: ~/.config/sd-power.conf, one target per line, in "<hub> <port>" format.
# Written automatically by `sd-power detect`.

set -uo pipefail

# Shortcuts, launchd and cron run with a minimal PATH (/usr/bin:/bin:...) where
# Homebrew is absent: without this addition, uhubctl is declared not found even
# though it is properly installed. Verified on 2026-08-19 by simulating `env -i PATH=...`.
PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

CONF="${SD_POWER_CONF:-$HOME/.config/sd-power.conf}"

die() { printf '%s\n' "$*" >&2; exit 1; }

command -v uhubctl >/dev/null 2>&1 || die "uhubctl introuvable — installe-le : brew install uhubctl"

# Lists the currently occupied ports, one per line: "<hub> <port> <description>"
occupied_ports() {
  local hub=""
  uhubctl 2>/dev/null | while IFS= read -r line; do
    case "$line" in
      "Current status for hub "*)
        hub="${line#Current status for hub }"
        hub="${hub%% *}"
        ;;
      *"connect"*)
        local port="${line#*Port }"
        port="${port%%:*}"
        printf '%s %s %s\n' "$hub" "$port" "${line#*\[}"
        ;;
    esac
  done
}

read_targets() {
  [ -f "$CONF" ] || die "Pas de config : $CONF
Lance d'abord :  sd-power detect"
  local t
  t="$(grep -vE '^\s*(#|$)' "$CONF")"
  # A config reduced to its comments is NOT a harmless empty config: the state-reading
  # loop would run zero times, hence "all the targets are cut", hence a false "off" — and
  # the toggle would send an "on" into the void.
  [ -n "$t" ] || die "Config sans cible : $CONF
Lance d'abord :  sd-power detect"
  printf '%s\n' "$t"
}

cmd_detect() {
  printf 'Détection du port qui porte le Stream Deck.\n\n'
  printf '1. DÉBRANCHE le Stream Deck du dock (ou le hub sur lequel il est branché).\n'
  printf '   Puis appuie sur Entrée. '
  read -r _
  local before after
  before="$(occupied_ports | awk '{print $1, $2}' | sort)"

  printf '\n2. REBRANCHE-le, attends 3 secondes, puis appuie sur Entrée. '
  read -r _
  after="$(occupied_ports | awk '{print $1, $2}' | sort)"

  local appeared
  appeared="$(comm -13 <(printf '%s\n' "$before") <(printf '%s\n' "$after"))"

  if [ -z "$appeared" ]; then
    die "
Aucun port n'est apparu entre les deux relevés.
Causes possibles : le Stream Deck est branché derrière un hub qui n'expose pas
le ppps, ou le débranchement/rebranchement n'a pas été détecté. Relance en
laissant 3-4 s après le rebranchement."
  fi

  # Discard the ports INTERNAL to a hub already retained. Replugging a hub makes its port
  # on the dock AND the occupied ports inside it appear all at once; cutting the dock's
  # port already takes the whole descent with it. Worse, an internal port's id ("32-2.2")
  # is derived from the USB enumeration of the moment: it may designate nothing at all by
  # the next session. And a dead target is not neutral — uhubctl fails on it, the state
  # becomes unreadable, and the toggle would permanently believe everything is on.
  local filtered="" h p h2 p2 child
  while read -r h p; do
    [ -n "${h:-}" ] || continue
    child=0
    while read -r h2 p2; do
      [ -n "${h2:-}" ] || continue
      [ "$h $p" = "$h2 $p2" ] && continue
      case "$h" in "$h2.$p2"|"$h2.$p2".*) child=1 ;; esac
    done <<< "$appeared"
    [ "$child" -eq 0 ] && filtered="${filtered}${h} ${p}
"
  done <<< "$appeared"
  appeared="$(printf '%s' "$filtered")"

  mkdir -p "$(dirname "$CONF")"
  {
    printf '# Généré par `sd-power detect` le %s\n' "$(date '+%Y-%m-%d %H:%M')"
    printf '# Ports du dock Dell WD19TB portant le Stream Deck Plus et sa descendance.\n'
    printf '# Format : <hub> <port>. La paire USB 2.0 + USB 3.x doit être coupée ENSEMBLE,\n'
    printf '# sinon le +5 V subsiste par le chemin resté actif.\n'
    printf '%s\n' "$appeared"
  } > "$CONF"

  printf '\nConfig écrite dans %s :\n' "$CONF"
  printf '%s\n' "$appeared" | sed 's/^/  /'
  local n
  n="$(printf '%s\n' "$appeared" | grep -c .)"
  if [ "$n" -lt 2 ]; then
    printf '\n⚠️  Une seule cible détectée. Si `sd-power off` laisse le Stream Deck\n'
    printf '   alimenté, c'"'"'est que le jumeau USB 3.x manque : ajoute-le à la main.\n'
  fi
}

cmd_set() {
  local action="$1" rc=0
  while read -r hub port; do
    [ -n "${hub:-}" ] || continue
    uhubctl -l "$hub" -p "$port" -a "$action" >/dev/null 2>&1 || rc=1
  done < <(read_targets)
  [ "$rc" -eq 0 ] || printf 'Au moins une cible a refusé la commande.\n' >&2
  printf 'Stream Deck : %s\n' "$([ "$action" = off ] && echo 'COUPÉ' || echo 'SOUS TENSION')"
}

# Global state: "off" only if ALL the targets are cut, "inconnu" as soon as one target
# does not answer. That third case is indispensable: without it, a vanished port made a
# `grep` silent, hence "not off", hence "on" — and the toggle cut indefinitely without
# ever restoring. An unreadable state must be stated, not guessed.
current_state() {
  local all_off=1 line
  while read -r hub port; do
    [ -n "${hub:-}" ] || continue
    line="$(uhubctl -l "$hub" -p "$port" 2>/dev/null | grep "Port $port:")"
    [ -n "$line" ] || { echo inconnu; return; }
    case "$line" in *"0000 off"*) ;; *) all_off=0 ;; esac
  done < <(read_targets)
  [ "$all_off" -eq 1 ] && echo off || echo on
}

cmd_status() {
  printf 'État : %s\n\n' "$(current_state)"
  while read -r hub port; do
    [ -n "${hub:-}" ] || continue
    uhubctl -l "$hub" -p "$port" 2>/dev/null | grep "Port $port:" | sed "s/^/  $hub /"
  done < <(read_targets)
}

# The config validation has to happen HERE, in the main shell: called from a
# process substitution (`< <(read_targets)`), `die`'s `exit` only kills the subshell
# and the script would carry on with a false "off" state.
require_conf() { read_targets >/dev/null; }

case "${1:-toggle}" in
  off)    require_conf; cmd_set off ;;
  on)     require_conf; cmd_set on ;;
  toggle) require_conf
          case "$(current_state)" in
            off) cmd_set on ;;
            on)  cmd_set off ;;
            *)   die "État illisible : au moins une cible de $CONF ne répond plus.
Relance \`sd-power detect\` — les ports ont pu être renumérotés." ;;
          esac ;;
  cycle)  require_conf; cmd_set off; sleep 2; cmd_set on ;;
  status) require_conf; cmd_status ;;
  detect) cmd_detect ;;
  *)      die "Usage : sd-power [toggle|off|on|cycle|status|detect]" ;;
esac
