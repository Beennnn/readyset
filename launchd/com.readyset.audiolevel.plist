<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.readyset.audiolevel</string>
    <!-- The audio-level probe. Runs as its OWN long-lived process so it can hold the macOS
         audio permission (a subprocess spawned by the dashboard cannot inherit it). Writes
         "<rms> <epoch>" to the file below every second; the engine reads it via [audiolevel].
         Args are substituted by audiolevel/install-daemon.sh: __ARGS__ = interval file [bundle]. -->
    <key>ProgramArguments</key>
    <array>
        <string>__RIG_DIR__/audiolevel/audiolevel</string>
        <string>--daemon</string>
        __ARGS__
    </array>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__RIG_DIR__/logs/audiolevel.log</string>
    <key>StandardErrorPath</key>
    <string>__RIG_DIR__/logs/audiolevel.log</string>
</dict>
</plist>
