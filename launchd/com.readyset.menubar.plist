<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.readyset.menubar</string>
    <!-- bash -lc wrapper: launchd refuses to bootstrap the bare GUI Mach-O directly
         (I/O error 5), but the same binary launched through a login shell works. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>exec '/Applications/RigMenuBar.app/Contents/MacOS/RigMenuBar'</string>
    </array>
    <!-- Relaunched ONLY if it went down. `KeepAlive` set to `true` also relaunched
         after a « ⏻ Quitter readyset » from the menu, which made a deliberate exit
         impossible: the app came back within the second. We worked around it by
         unloading the agent (`launchctl bootout`) — and the remedy was worse, since the
         service stayed unloaded until the next session, so readyset no longer restarted at
         login as long as it was not reloaded by hand.
         With `SuccessfulExit: false`, launchd only relaunches on a NON-ZERO exit code.
         Quitting cleanly (code 0) is respected; a crash is caught. The `exec` in the
         command line above is what makes the nuance work: without it, launchd would
         read bash's exit code and not the app's. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__RIG_DIR__/logs/menubar.log</string>
    <key>StandardErrorPath</key>
    <string>__RIG_DIR__/logs/menubar.log</string>
</dict>
</plist>
