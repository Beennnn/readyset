<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.readyset.menubar</string>
    <!-- bash -lc wrapper: launchd refuses to bootstrap the bare GUI Mach-O directly
         (I/O error 5), but the same binary launched through a login shell works. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>exec '/Applications/RigMenuBar.app/Contents/MacOS/RigMenuBar'</string>
    </array>
    <!-- Relancée SEULEMENT si elle est tombée. `KeepAlive` à `true` relançait aussi
         après un « ⏻ Quitter iRig » du menu, ce qui rendait la sortie volontaire
         impossible : l'app revenait dans la seconde. On la contournait en déchargeant
         l'agent (`launchctl bootout`) — et le remède était pire, puisque le service
         restait déchargé jusqu'à la session suivante, donc iRig ne redémarrait plus au
         login tant qu'on ne le rechargeait pas à la main.
         Avec `SuccessfulExit: false`, launchd ne relance que sur un code de sortie NON
         NUL. Quitter proprement (code 0) est respecté ; un crash est rattrapé. Le
         `exec` de la ligne de commande ci-dessus est ce qui fait marcher la nuance :
         sans lui, launchd lirait le code de bash et non celui de l'app. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__RIG_DIR__/logs/menubar.log</string>
    <key>StandardErrorPath</key>
    <string>__RIG_DIR__/logs/menubar.log</string>
</dict>
</plist>
